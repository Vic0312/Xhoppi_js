<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" type="text/css" href="/css/style.css">
    <link rel="stylesheet" type="text/css" href="/css/rodape.css">
    <link rel="icon" href="/img/logo.png" type="image/png">
    <title>Xhopii - Ver Clientes</title>
    <style>
        .tabela-dados {
            width: 95%;
            margin: 20px auto;
            border-collapse: collapse;
            background: #fff;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        .tabela-dados th, .tabela-dados td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: center;
        }
        .tabela-dados th {
            background-color: #ee4d2d;
            color: white;
        }
        .tabela-dados img {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 50%;
        }
        .btn-acao {
            padding: 6px 12px;
            text-decoration: none;
            color: white;
            border-radius: 4px;
            font-weight: bold;
            display: inline-block;
            margin: 2px;
        }
        .btn-editar { background-color: #28a745; }
        .btn-excluir { background-color: #dc3545; }
    </style>
</head>
<body>

    <header>
        <section id="cabecalho-logo">
            <img src="/img/logo.png" alt="Logo">
            <h1>Xhopii</h1>
        </section>
        <section id="cabecalho-logout">
            <a href="/login">Sair</a>
        </section>
    </header>

    <nav class="menu-horizontal">
        <ul>
            <li><a href="/home">Home</a></li>
            <li><a href="/clientes/cadastrar">Cadastro Cliente</a></li>
            <li><a href="/funcionario/cadastrar">Cadastro Funcionário</a></li>
            <li><a href="/produto/cadastrar">Cadastro Produto</a></li>
            <li><a href="/clientes/visualizar">Ver Clientes</a></li>
            <li><a href="/funcionarios/visualizar">Ver Funcionários</a></li>
            <li><a href="/produtos">Ver Produtos</a></li>
        </ul>
    </nav>

    <section class="conteudo-ver">
        <section class="conteudo-ver-descobertas">
            <section class="conteudo-ver-descobertas-titulo">
                <h1>Gerenciamento de Clientes</h1>
            </section>
            
            <table class="tabela-dados">
                <thead>
                    <tr>
                        <th>Foto</th>
                        <th>CPF</th>
                        <th>Nome Completo</th>
                        <th>Data Nasc.</th>
                        <th>Telefone</th>
                        <th>E-mail</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (clientes.length === 0) { %>
                        <tr>
                            <td colspan="7">Nenhum cliente cadastrado.</td>
                        </tr>
                    <% } else { %>
                        <% clientes.forEach(cliente => { %>
                            <tr>
                                <td><img src="/imgcliente/<%= cliente.foto_perfil %>" alt="Foto"></td>
                                <td><%= cliente.cpf %></td>
                                <td><%= cliente.nome %> <%= cliente.sobrenome %></td>
                                <td><%= cliente.dataNasc %></td>
                                <td><%= cliente.telefone %></td>
                                <td><%= cliente.email %></td>
                                <td>
                                    <a href="/cliente/editar/<%= cliente.cpf %>" class="btn-acao btn-editar">Editar</a>
                                    <a href="/cliente/deletar/<%= cliente.cpf %>" class="btn-acao btn-excluir" onclick="return confirm('Tem certeza que deseja excluir este cliente?')">Excluir</a>
                                </td>
                            </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </section>
    </section>

    <footer class="rodape">
        <div class="container-footer">
            <section>
                <h1 class="h1-rdp">Atendimento ao cliente</h1>
                <p class="p-rdp">Central de Ajuda</p>
                <p class="p-rdp">Como Comprar</p>
                <p class="p-rdp">Métodos de Pagamento</p>
                <p class="p-rdp">Garantia Xhopii</p>
                <p class="p-rdp">Devolução e Reembolso</p>
                <p class="p-rdp">Fale Conosco</p>
                <p class="p-rdp">Ouvidoria</p>
                <p class="p-rdp">Preferências de cookies</p>
            </section>

            <section>
                <h1 class="h1-rdp">Sobre a Xhopii</h1>
                <p class="p-rdp">Sobre Nós</p>
                <p class="p-rdp">Políticas Xhopii</p>
                <p class="p-rdp">Política de Privacidade</p>
                <p class="p-rdp">Programa de Afiliados da Xhopii</p>
                <p class="p-rdp">Seja um Entregador Xhopii</p>
                <p class="p-rdp">Ofertas Relâmpago</p>
                <p class="p-rdp">Xhopii Blog</p>
                <p class="p-rdp">Imprensa</p>
            </section>

            <section>
                <h1 class="h1-rdp">Pagamento</h1>
                <img class="imgpg" src="/img/logo-visa.png" alt="Visa">
                <img class="imgpg" src="/img/logo-mastercard.png" alt="Mastercard">
                <img class="imgpg" src="/img/logo-pix.png" alt="Pix">
            </section>

            <section>
                <h1 class="h1-rdp">Siga-nos</h1>
                <p class="p-rdp"><img class="icon" src="/img/logo-instagram.png" alt="Instagram">Instagram</p>
                <p class="p-rdp"><img class="icon" src="/img/logo-tiktok.png" alt="TikTok">TikTok</p>
                <p class="p-rdp"><img class="icon" src="/img/logo-facebook.png" alt="Facebook">Facebook</p>
            </section>

            <section>
                <h1 class="h1-rdp">Atendimento ao cliente</h1>
                <img class="qr" src="/img/qr-code.png" alt="QR Code"><br>
                <img class="stre" src="/img/logo-store-apple.png" alt="App Store"><br>
                <img class="stre" src="/img/logo-google-play.png" alt="Google Play">
            </section>

            <hr id="hr-rdp">
        </div>
        <p class="p-rdp" style="text-align: center; margin-bottom: 20px;">© 2025 Xhopii. Todos os direitos acadêmicos reservados</p>
    </footer>

</body>
</html>