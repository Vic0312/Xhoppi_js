<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" type="text/css" href="/css/style.css">
    <link rel="icon" href="/img/logo.png" type="image/png">
    <title>Xhopii - Ver Produtos</title>
    <style>
        .tabela-produtos {
            width: 95%;
            margin: 20px auto;
            border-collapse: collapse;
            background: #fff;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        .tabela-produtos th, .tabela-produtos td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: center;
        }
        .tabela-produtos th {
            background-color: #ee4d2d;
            color: white;
        }
        .tabela-produtos img {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 4px;
        }
        .btn-acao {
            padding: 6px 12px;
            text-decoration: none;
            color: white;
            border-radius: 4px;
            font-weight: bold;
            display: inline-block;
            margin: 2px;
        }
        .btn-editar { background-color: #28a745; }
        .btn-excluir { background-color: #dc3545; }
    </style>
</head>
<body>

    <header>
        <section id="cabecalho-logo">
            <img src="/img/logo.png" alt="Logo">
            <h1>Xhopii</h1>
        </section>
        <section id="cabecalho-logout">
            <a href="/login">Sair</a>
        </section>
    </header>

    <nav class="menu-horizontal">
        <ul>
            <li><a href="/home">Home</a></li>
            <li><a href="/clientes/cadastrar">Cadastro Cliente</a></li>
            <li><a href="/funcionario/cadastrar">Cadastro Funcionário</a></li>
            <li><a href="/produto/cadastrar">Cadastro Produto</a></li>
            <li><a href="/clientes/visualizar">Ver Clientes</a></li>
            <li><a href="/funcionarios/visualizar">Ver Funcionários</a></li>
            <li><a href="/produtos">Ver Produtos</a></li>
        </ul>
    </nav>

    <section class="conteudo-ver">
        <section class="conteudo-ver-descobertas">
            <section class="conteudo-ver-descobertas-titulo">
                <h1>Gerenciamento de Produtos</h1>
            </section>
            
            <table class="tabela-produtos">
                <thead>
                    <tr>
                        <th>Imagem</th>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Fabricante</th>
                        <th>Descrição</th>
                        <th>Valor</th>
                        <th>Estoque</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (produtos.length === 0) { %>
                        <tr>
                            <td colspan="8">Nenhum produto cadastrado.</td>
                        </tr>
                    <% } else { %>
                        <% produtos.forEach(produto => { %>
                            <tr>
                                <td><img src="/imgprod/<%= produto.foto_prod %>" alt="Foto"></td>
                                <td><%= produto.id_prod %></td>
                                <td><%= produto.nome %></td>
                                <td><%= produto.fabricante %></td>
                                <td><%= produto.descricao %></td>
                                <td>R$ <%= parseFloat(produto.valor).toFixed(2) %></td>
                                <td><%= produto.quantidade %></td>
                                <td>
                                    <a href="/produto/editar/<%= produto.id_prod %>" class="btn-acao btn-editar">Editar</a>
                                    <a href="/produto/deletar/<%= produto.id_prod %>" class="btn-acao btn-excluir" onclick="return confirm('Tem certeza que deseja excluir este produto?')">Excluir</a>
                                </td>
                            </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </section>
    </section>

    <footer class="rodape">
        <hr>
        <p>© 2025 Xhopii. Todos os direitos acadêmicos reservados</p>
    </footer>

</body>
</html>