<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" type="text/css" href="/css/style.css">
    <link rel="icon" href="/img/logo.png" type="image/png">
    <title>Xhopii - Ver Funcionários</title>
    <style>
        .tabela-dados {
            width: 95%;
            margin: 20px auto;
            border-collapse: collapse;
            background: #fff;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        .tabela-dados th, .tabela-dados td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: center;
        }
        .tabela-dados th {
            background-color: #ee4d2d;
            color: white;
        }
        .tabela-dados img {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 50%;
        }
        .btn-acao {
            padding: 6px 12px;
            text-decoration: none;
            color: white;
            border-radius: 4px;
            font-weight: bold;
            display: inline-block;
            margin: 2px;
        }
        .btn-editar { background-color: #28a745; }
        .btn-excluir { background-color: #dc3545; }
    </style>
</head>
<body>

    <header>
        <section id="cabecalho-logo">
            <img src="/img/logo.png" alt="Logo">
            <h1>Xhopii</h1>
        </section>
        <section id="cabecalho-logout">
            <a href="/login">Sair</a>
        </section>
    </header>

    <nav class="menu-horizontal">
        <ul>
            <li><a href="/home">Home</a></li>
            <li><a href="/clientes/cadastrar">Cadastro Cliente</a></li>
            <li><a href="/funcionario/cadastrar">Cadastro Funcionário</a></li>
            <li><a href="/produto/cadastrar">Cadastro Produto</a></li>
            <li><a href="/clientes/visualizar">Ver Clientes</a></li>
            <li><a href="/funcionarios/visualizar">Ver Funcionários</a></li>
            <li><a href="/produtos">Ver Produtos</a></li>
        </ul>
    </nav>

    <section class="conteudo-ver">
        <section class="conteudo-ver-descobertas">
            <section class="conteudo-ver-descobertas-titulo">
                <h1>Gerenciamento de Funcionários</h1>
            </section>
            
            <table class="tabela-dados">
                <thead>
                    <tr>
                        <th>Foto</th>
                        <th>CPF</th>
                        <th>Nome Completo</th>
                        <th>Cargo</th>
                        <th>Salário</th>
                        <th>E-mail</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (funcionarios.length === 0) { %>
                        <tr>
                            <td colspan="7">Nenhum funcionário cadastrado.</td>
                        </tr>
                    <% } else { %>
                        <% funcionarios.forEach(func => { %>
                            <tr>
                                <td><img src="/imgfunc/<%= func.foto_perfil %>" alt="Foto"></td>
                                <td><%= func.cpf %></td>
                                <td><%= func.nome %> <%= func.sobrenome %></td>
                                <td><%= func.cargo %></td>
                                <td>R$ <%= parseFloat(func.salario).toFixed(2) %></td>
                                <td><%= func.email %></td>
                                <td>
                                    <a href="/funcionario/editar/<%= func.cpf %>" class="btn-acao btn-editar">Editar</a>
                                    <a href="/funcionario/deletar/<%= func.cpf %>" class="btn-acao btn-excluir" onclick="return confirm('Tem certeza que deseja excluir este funcionário?')">Excluir</a>
                                </td>
                            </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </section>
    </section>

    <footer class="rodape">
        <hr>
        <p>© 2025 Xhopii. Todos os direitos acadêmicos reservados</p>
    </footer>

</body>
</html>